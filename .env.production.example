# Copy the required values into the deployment's protected .env file.
# Never commit the real passwords or API keys.
MONIPAN_ENVIRONMENT=production
MONIPAN_MYSQL_DATABASE=monipan
MONIPAN_MYSQL_USER=monipan
# The application password is embedded in a SQLAlchemy URL by compose.yaml.
# Until that assembly is refactored, use 32+ random URL-safe characters from
# A-Z, a-z, 0-9, underscore and hyphen. The root password has no such limit.
MONIPAN_MYSQL_PASSWORD=replace-with-a-unique-database-password
MONIPAN_MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MONIPAN_COOKIE_SECURE=1
MONIPAN_SESSION_DAYS=7

# Keep this at 0 while the Compose stack has exactly one backend instance.
MONIPAN_DISABLE_MARKET_LOOP=0

# Optional external services. Leave empty to use the application's explicit
# degraded/unavailable behavior instead of storing a placeholder secret.
TAVILY_API_KEY=
MONIPAN_AGENT_API_KEY=
DEEPSEEK_API_KEY=
